# Python backend
backend/venv/
backend/__pycache__/
backend/.env
backend/cache_*.json
# Per-user runtime data (mirrors cache_*.json — not source, regenerated per user/server)
backend/tracking_*@*.json
backend/not_tracked_*@*.json
backend/activity_log.json
# Rotating app log (LOG_FILE) — runtime output, regenerated on every boot
backend/logs/
# Cached email bodies for offline reading — real mail content, never commit
backend/detail_cache/

# Node frontend
frontend-new/node_modules/
frontend-new/dist/

# Old, incomplete frontend (not part of this push)
frontend/

# Editor/OS
.vscode/
backend/.claude/
backend/*.code-workspace
Thumbs.db
# Cache backups — same real mail content as the caches themselves
backend/*.bak
*.bak
# Queued actions awaiting the mail server — per-user runtime state
backend/outbox_*.json
# Per-user runtime data from Admin (thread notes, send settings, signatures) —
# real note/signature content, mirrors tracking_*@*.json above, never commit
backend/thread_notes_*@*.json
backend/send_settings_*@*.json
backend/signatures_*@*.json
